# syntax=docker/dockerfile:1.4
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The Hyva source is cloned on the CI runner and mounted into the build via
# BuildKit's bind mount, so the SSH key used to fetch it never touches the
# container and the source does not bloat any image layer. Composer installs
# the packages into vendor/ from local path repositories, then the mount
# disappears when the RUN completes.
RUN --mount=type=bind,source=hyva-src,target=/tmp/hyva-src,ro \
    set -e; \
    ./start-services; \
    for dir in /tmp/hyva-src/*/; do \
      pkg="hyva-themes/$(basename "$dir")"; \
      composer config "repositories.${pkg}" \
        "{\"type\":\"path\",\"url\":\"${dir%/}\",\"options\":{\"symlink\":false}}"; \
    done; \
    ./retry "composer require hyva-themes/magento2-default-theme hyva-themes/magento2-luma-checkout --no-interaction"; \
    for dir in /tmp/hyva-src/*/; do \
      pkg="hyva-themes/$(basename "$dir")"; \
      composer config --unset "repositories.${pkg}"; \
    done; \
    php bin/magento setup:upgrade; \
    php bin/magento config:set --lock-config design/theme/theme_id Hyva/default; \
    php bin/magento config:set --lock-config hyva_theme_fallback/general/enable 1; \
    php bin/magento setup:static-content:deploy en_US -f -j 12; \
    php bin/magento setup:di:compile; \
    php bin/magento indexer:reindex; \
    php bin/magento cache:flush; \
    ./stop-services
